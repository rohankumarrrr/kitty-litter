{
  "permissions": {
    "deny": [
      "Read(~/.t3/userdata/**)",
      "Read(~/.t3/scratch/**)",
      "Read(~/.claude/projects/**/*.jsonl)",
      "Read(~/.codex/**)",
      "Read(~/Library/Application Support/shades/captures/**)",
      "Edit(~/.t3/userdata/**)",
      "Edit(.claude/**)",
      "mcp__t3-code__t3_thread_search",
      "mcp__t3-code__t3_thread_transfer",
      "mcp__t3-code__t3_queue"
    ]
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": false,
    "autoAllowBashIfSandboxed": false,
    "enableWeakerNetworkIsolation": true,
    "excludedCommands": [
      "swift build*",
      "swift test*",
      "swift run*",
      "swift scripts/*",
      "scripts/bundle.sh*",
      "scripts/install.sh*",
      "~/shades/scripts/install.sh*"
    ],
    "network": {
      "allowedDomains": [
        "github.com",
        "api.github.com",
        "*.githubusercontent.com"
      ]
    }
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "mcp__t3-code__t3_thread_read",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"$CLAUDE_PROJECT_DIR/.claude/hooks/thread-read-filter.py\""
          }
        ]
      }
    ]
  }
}
